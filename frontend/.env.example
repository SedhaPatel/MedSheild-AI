# MedShield-AI Frontend Environment Variables
# Copy to `.env` or `.env.local` for local customization, or set in your static host's build environment.

# Public FastAPI backend origin baked in at Vite build time (e.g. https://medshield-api.up.railway.app).
# - Leave empty for local Vite dev (`npm run dev` proxies `/api/*`) and unified single-container deployments.
# - Set for split CDN hosting (Netlify / Vercel / Cloudflare Pages -> Railway / Render).
#   Ensure the backend's MEDSHIELD_CORS_ORIGINS includes this frontend's origin.
VITE_API_BASE_URL=

# Local Vite dev-server proxy target for `/api/*` requests when running `npm run dev`.
# Defaults to http://127.0.0.1:8000 if unset or empty. Ignored by production `vite build`.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
