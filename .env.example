# ==============================================================================
# MedShield-AI Backend Environment Configuration Template
# Copy to .env for local development or configure in your PaaS dashboard.
# NEVER commit a populated .env file containing real secrets or API keys.
# ==============================================================================

# --- Core Runtime ---
# Use "production" in deployed environments (enforces non-default MEDSHIELD_SECRET_PEPPER)
MEDSHIELD_ENVIRONMENT=development
MEDSHIELD_DEBUG=false
PORT=8000

# --- Cryptographic & Storage Settings ---
# REQUIRED in production: generate a unique random secret (e.g. `openssl rand -hex 32`)
MEDSHIELD_SECRET_PEPPER=replace-with-unique-random-secret-at-least-32-chars
MEDSHIELD_KMS_MASTER_KEY_ID=arn:medshield:kms:local:key/master-kek-v1
MEDSHIELD_STORAGE_BACKEND=local
# Use /app/storage/encrypted_studies inside Docker (mount persistent volume here)
MEDSHIELD_STORAGE_PATH=./storage/encrypted_studies

# --- Zero-Trust Edge & Network Security ---
MEDSHIELD_TLS_MIN_VERSION=TLSv1.3
# Set "true" when fronted by an mTLS gateway injecting X-Client-Cert-SHA256 for /api/v1/studies & /api/v1/inference.
# Set "false" for public browser SPA demos or unified container serving frontend/dist.
MEDSHIELD_REQUIRE_MTLS=false

# Comma-separated allowed browser origins for CORS (never use "*" with credentials).
# For split deployment, add your CDN origin e.g. https://medshield-ai.netlify.app,https://medshield-ai.vercel.app
MEDSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# --- Optional Unified Single-Container Frontend Hosting ---
# Set "true" only when FastAPI should serve the built Vite SPA from MEDSHIELD_FRONTEND_DIST_DIR
MEDSHIELD_SERVE_FRONTEND=false
MEDSHIELD_FRONTEND_DIST_DIR=./frontend/dist

# --- Deep Learning Inference ---
MEDSHIELD_MODEL_ARCHITECTURE=efficientnet_v2_s
# Optional path to custom local .pt checkpoint (defaults to TorchXRayVision DenseNet-121 weights/ cache)
MEDSHIELD_MODEL_CHECKPOINT_PATH=

# --- Zero-PII Clinical Scan Chat VLM Assistant ---
# Supported providers: "gemini" | "medgemma" (or "huggingface") | "ollama" | "local" | "auto"
# Leave API keys blank to use the deterministic grounded local fallback synthesizer.
MEDSHIELD_CHAT_PROVIDER=gemini
GEMINI_API_KEY=
MEDSHIELD_GEMINI_MODEL=gemini-2.5-flash
HF_API_TOKEN=
MEDSHIELD_MEDGEMMA_MODEL=google/medgemma-1.5-4b-it
MEDSHIELD_OLLAMA_BASE_URL=http://127.0.0.1:11434
MEDSHIELD_OLLAMA_MODEL=llama3.2-vision
MEDSHIELD_CHAT_TIMEOUT_SEC=25.0
